menu "NOTE4 Bus Board"

config BUS_WIFI_SSID
    string "Wi-Fi SSID (default; NVS 'bus-set' overrides)"
    default ""

config BUS_WIFI_PASSWORD
    string "Wi-Fi password (default; NVS 'bus-set' overrides)"
    default ""

